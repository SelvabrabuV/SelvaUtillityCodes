<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="DiffDesk.Desktop.Views.ConfirmWindow"
        Width="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <StackPanel Margin="20" Spacing="14">
    <TextBlock x:Name="MessageText" TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Cancel" IsCancel="True" Click="CancelClick" />
      <Button Content="Continue" IsDefault="True" Click="ContinueClick" />
    </StackPanel>
  </StackPanel>
</Window>
