<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffDesk.Desktop.ViewModels"
             xmlns:controls="using:DiffDesk.Desktop.Controls"
             x:Class="DiffDesk.Desktop.Views.MergeView"
             x:DataType="vm:MergeViewModel">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Text="Base" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding BasePath}" />
        <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseBaseCommand}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Text="Left" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding LeftPath}" />
        <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseLeftCommand}" />
      </Grid>
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Text="Right" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding RightPath}" />
        <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseRightCommand}" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Merge" Command="{Binding MergeCommand}" />
        <Button Content="Use left" Command="{Binding ResolveLeftCommand}" />
        <Button Content="Use right" Command="{Binding ResolveRightCommand}" />
        <Button Content="Use both" Command="{Binding ResolveBothCommand}" />
        <Button Content="Save" Command="{Binding SaveCommand}" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
    <Grid ColumnDefinitions="280,*" ColumnSpacing="8">
      <ListBox ItemsSource="{Binding Pieces}" SelectedItem="{Binding SelectedPiece}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:PieceRow">
            <StackPanel Margin="0,4">
              <TextBlock Text="{Binding Kind}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Left}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Right}" TextWrapping="Wrap" Opacity="0.75" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <controls:BindableEditor Grid.Column="1" BoundText="{Binding Rendered}" IsReadOnly="True" />
    </Grid>
  </DockPanel>
</UserControl>
