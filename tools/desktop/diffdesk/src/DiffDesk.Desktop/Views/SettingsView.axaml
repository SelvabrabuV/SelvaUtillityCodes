<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffDesk.Desktop.ViewModels"
             x:Class="DiffDesk.Desktop.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <StackPanel Margin="16" Spacing="12" MaxWidth="520">
    <TextBlock Text="Settings" FontSize="20" />
    <TextBlock Text="Theme" />
    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" HorizontalAlignment="Left" MinWidth="180" />
    <CheckBox Content="Restore open tabs next time" IsChecked="{Binding RestoreTabs}" />
    <Button Content="Save settings" Command="{Binding SaveCommand}" HorizontalAlignment="Left" />
    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
