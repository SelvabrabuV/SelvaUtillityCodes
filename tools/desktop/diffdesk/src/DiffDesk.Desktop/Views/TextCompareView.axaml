<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:DiffDesk.Desktop.ViewModels"
             xmlns:controls="using:DiffDesk.Desktop.Controls"
             x:Class="DiffDesk.Desktop.Views.TextCompareView"
             x:DataType="vm:TextCompareViewModel">
  <DockPanel Margin="12">
    <StackPanel DockPanel.Dock="Top" Spacing="8">
      <Grid ColumnDefinitions="Auto,*,Auto,Auto,*,Auto" ColumnSpacing="8">
        <TextBlock Text="Left" VerticalAlignment="Center" />
        <TextBox Grid.Column="1" Text="{Binding LeftPath}" />
        <Button Grid.Column="2" Content="Browse" Command="{Binding BrowseLeftCommand}" />
        <TextBlock Grid.Column="3" Text="Right" VerticalAlignment="Center" />
        <TextBox Grid.Column="4" Text="{Binding RightPath}" />
        <Button Grid.Column="5" Content="Browse" Command="{Binding BrowseRightCommand}" />
      </Grid>
      <WrapPanel Orientation="Horizontal">
        <CheckBox Content="Ignore case" IsChecked="{Binding IgnoreCase}" Margin="0,0,12,4" />
        <CheckBox Content="Ignore whitespace" IsChecked="{Binding IgnoreWhitespace}" Margin="0,0,12,4" />
        <CheckBox Content="Ignore blank lines" IsChecked="{Binding IgnoreBlankLines}" Margin="0,0,12,4" />
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Compare" Command="{Binding CompareCommand}" />
        <Button Content="Copy hunk to right" Command="{Binding CopyToRightCommand}" />
        <Button Content="Copy hunk to left" Command="{Binding CopyToLeftCommand}" />
        <Button Content="Save left" Command="{Binding SaveLeftCommand}" />
        <Button Content="Save right" Command="{Binding SaveRightCommand}" />
        <TextBox x:Name="FindBox" Width="140" PlaceholderText="Find" Text="{Binding FindText}" />
        <TextBox x:Name="ReplaceBox" Width="140" PlaceholderText="Replace" Text="{Binding ReplaceText}" />
        <Button Content="Find" Click="FindClick" />
        <Button Content="Replace all" Click="ReplaceClick" />
      </StackPanel>
      <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
    </StackPanel>
    <Grid ColumnDefinitions="*,220,*" ColumnSpacing="8">
      <controls:BindableEditor x:Name="LeftEditor" BoundText="{Binding LeftText}" />
      <ListBox Grid.Column="1" ItemsSource="{Binding Hunks}" SelectedItem="{Binding SelectedHunk}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:HunkRow">
            <StackPanel Margin="0,4">
              <TextBlock Text="{Binding LeftStart}" />
              <TextBlock Text="{Binding LeftPreview}" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{Binding RightPreview}" TextTrimming="CharacterEllipsis" Opacity="0.75" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <controls:BindableEditor Grid.Column="2" x:Name="RightEditor" BoundText="{Binding RightText}" />
    </Grid>
  </DockPanel>
</UserControl>
